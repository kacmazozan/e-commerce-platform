FRONTEND_URL=http://localhost:5173
MIGRATION_CHECK_ORDER=false

# Default Docker development uses MailHog.
SMTP_HOST=mailserver
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SENDER_EMAIL=invoices@fier.com

# Gmail SMTP example for Docker Compose:
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_SECURE=true
# SMTP_USER=your-address@gmail.com
# SMTP_PASS=your-google-app-password
# SENDER_EMAIL="Fier <your-address@gmail.com>"
