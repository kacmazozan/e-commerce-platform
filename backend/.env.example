PORT=3000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ecommerce
JWT_SECRET=change-this-secret
# 32 random bytes, base64 encoded. Generate with:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
DATA_ENCRYPTION_KEY=replace-with-32-byte-base64-key
MIGRATION_CHECK_ORDER=false
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173
JSON_BODY_LIMIT=100kb
SENSITIVE_RATE_LIMIT_WINDOW_MS=900000
SENSITIVE_RATE_LIMIT_MAX=20
TRUST_PROXY=false

# Copy this file to .env and fill in real local-only secrets.
# Keep .env ignored; do not commit live SMTP app passwords.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=fier.mailing@gmail.com
SMTP_PASS=your-google-app-password
SENDER_EMAIL="Fier <fier.mailing@gmail.com>"

ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=admin123456
SALES_MANAGER_EMAIL=salesmanager@example.com
SALES_MANAGER_PASSWORD=salesmanager123456
SALES_MANAGER_NAME=Jane Smith
PRODUCT_MANAGER_EMAIL=productmanager@example.com
PRODUCT_MANAGER_PASSWORD=productmanager123456
PRODUCT_MANAGER_NAME=John Doe
